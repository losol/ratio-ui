{
  "name": "@eventuras/ratio-ui-sandbox",
  "version": "0.0.0",
  "description": "Alpha — run interactive React examples in a frame on a separate sandbox origin, with a browser runtime of Ratio UI",
  "license": "MPL-2.0",
  "homepage": "https://github.com/losol/ratio-ui/tree/main/packages/ratio-ui-sandbox#readme",
  "bugs": {
    "url": "https://github.com/losol/ratio-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/losol/ratio-ui.git",
    "directory": "packages/ratio-ui-sandbox"
  },
  "keywords": [
    "ratio-ui",
    "sandbox",
    "iframe",
    "import-map",
    "alpha"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Sandbox": {
      "types": "./dist/Sandbox/index.d.ts",
      "import": "./dist/Sandbox/index.js"
    },
    "./runtime/manifest.json": "./dist/runtime/manifest.json",
    "./runtime/*": "./dist/runtime/*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build-runtime.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eventuras/eslint-config": "^1.0.6",
    "@eventuras/ratio-ui": "workspace:^",
    "@eventuras/typescript-config": "^1.1.1",
    "@eventuras/vite-config": "^0.5.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
