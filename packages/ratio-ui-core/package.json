{
  "name": "@eventuras/ratio-ui-core",
  "version": "0.4.0",
  "description": "The design system as data — theme values, the token vocabulary, and the pure rules every renderer of Ratio UI must agree on. No React, no DOM, no CSS.",
  "keywords": [
    "design-tokens",
    "theme",
    "ratio-ui",
    "open-badges"
  ],
  "license": "MPL-2.0",
  "homepage": "https://github.com/losol/ratio-ui/tree/main/packages/ratio-ui-core#readme",
  "bugs": {
    "url": "https://github.com/losol/ratio-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/losol/ratio-ui.git",
    "directory": "packages/ratio-ui-core"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chat": {
      "types": "./dist/chat/index.d.ts",
      "import": "./dist/chat/index.js"
    },
    "./badges": {
      "types": "./dist/badges/index.d.ts",
      "import": "./dist/badges/index.js"
    },
    "./themes/*": {
      "types": "./dist/themes/*.d.ts",
      "import": "./dist/themes/*.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc --emitDeclarationOnly --outDir dist && vite build --emptyOutDir false && node scripts/check-imports.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eventuras/eslint-config": "^1.0.6",
    "@eventuras/typescript-config": "^1.1.1",
    "@eventuras/vite-config": "^0.5.0",
    "@types/node": "^24.19.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  }
}
