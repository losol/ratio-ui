{
  "name": "@eventuras/markdown-core",
  "version": "0.1.0",
  "description": "Framework-agnostic markdown utilities and remark plugins — input normalization, sanitize-schema merging, heading extraction, GitHub-style callouts.",
  "keywords": [
    "markdown",
    "remark",
    "rehype",
    "unified"
  ],
  "license": "MPL-2.0",
  "homepage": "https://github.com/losol/ratio-ui/tree/main/packages/markdown-core#readme",
  "bugs": {
    "url": "https://github.com/losol/ratio-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/losol/ratio-ui.git",
    "directory": "packages/markdown-core"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run clean && vite build && node scripts/check-imports.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eventuras/eslint-config": "^1.0.4",
    "@eventuras/typescript-config": "^1.0.0",
    "@eventuras/vite-config": "^0.3.1",
    "@types/mdast": "^4.0.4",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  }
}
