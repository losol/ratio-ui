{
  "name": "@eventuras/markdown-react",
  "version": "0.1.0",
  "description": "React markdown engine — react-markdown (remark/rehype) behind a semantic renderer contract; design-system bindings supply the components.",
  "keywords": [
    "markdown",
    "react",
    "remark",
    "rehype"
  ],
  "license": "MPL-2.0",
  "homepage": "https://github.com/losol/ratio-ui/tree/main/packages/markdown-react#readme",
  "bugs": {
    "url": "https://github.com/losol/ratio-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/losol/ratio-ui.git",
    "directory": "packages/markdown-react"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run clean && vite build && node scripts/check-core-imports.mjs",
    "check:core-imports": "node scripts/check-core-imports.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react-markdown": "^10.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "@eventuras/markdown-core": "workspace:^"
  },
  "devDependencies": {
    "@eventuras/eslint-config": "^1.0.4",
    "@eventuras/typescript-config": "^1.0.0",
    "@eventuras/vite-config": "^0.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "30.0.1",
    "rehype-raw": "^7.0.0",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  }
}
